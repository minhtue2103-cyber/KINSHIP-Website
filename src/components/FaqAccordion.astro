---
interface FaqEntity {
  name: string;
  acceptedAnswer?: {
    text?: string;
  };
}

interface Props {
  faqEntities?: FaqEntity[];
}

const { faqEntities = [] } = Astro.props;
---

{faqEntities && faqEntities.length > 0 && (
  <section class="faq-section" aria-labelledby="faq-section-heading">
    <div class="faq-section__header">
      <span class="faq-section__eyebrow">❓ Hỏi &amp; Đáp Chuyên Sâu</span>
      <h2 id="faq-section-heading" class="faq-section__title">Câu hỏi thường gặp (FAQ)</h2>
      <p class="faq-section__subtitle">
        Giải đáp trực diện các băn khoăn phổ biến nhất của thế hệ Bánh Mì Kẹp.
      </p>
    </div>

    <div class="faq-list">
      {faqEntities.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span class="faq-question__text">{faq.name}</span>
            <span class="faq-question__icon" aria-hidden="true">▾</span>
          </summary>
          <div class="faq-answer">
            <p>{faq.acceptedAnswer?.text}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}

