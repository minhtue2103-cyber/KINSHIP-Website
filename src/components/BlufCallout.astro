---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<aside class="bluf-callout" aria-label="Bạn có biết..">
  <div class="bluf-callout__badge">
    <i class="bi bi-lightbulb-fill" aria-hidden="true"></i>
    <span>Bạn có biết..</span>
  </div>
  <p class="bluf-callout__text">{summary}</p>
</aside>
