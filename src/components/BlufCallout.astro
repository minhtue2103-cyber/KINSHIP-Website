---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<aside class="bluf-callout" aria-label="Tóm tắt trực diện BLUF">
  <div class="bluf-callout__badge">
    <span aria-hidden="true">💡</span>
    <span>Tóm tắt trực diện (BLUF)</span>
  </div>
  <p class="bluf-callout__text">{summary}</p>
</aside>

