---
import { MEDIA_ASSETS } from '../utils/media';

interface Props {
  authorName?: string;
  authorRole?: string;
  authorBio?: string;
  authorAvatar?: string;
}

const {
  authorName = 'Nhung Phạm',
  authorRole = 'Đồng sáng lập dự án Giúp Cha Mẹ',
  authorBio = 'Xuất phát từ những đêm mất ngủ vừa điều hành công việc vừa lo cho cha mẹ già, tôi cùng đội ngũ tạo ra điểm tựa thực tế để con cái không phải kiệt sức trên hành trình báo hiếu.',
  authorAvatar = MEDIA_ASSETS.avatars.nhungPham,
} = Astro.props;
---

<div
  class="author-geo-box"
  itemscope
  itemtype="https://schema.org/Person"
  aria-label="Thông tin tác giả và Hội đồng chuyên gia thẩm định"
>
  <div class="author-geo-box__inner">
    <img
      src={authorAvatar}
      alt={`${authorName} — Giúp Cha Mẹ`}
      class="author-geo-box__avatar"
      itemprop="image"
      width="56"
      height="56"
      loading="eager"
    />

    <div class="author-geo-box__content">
      <div class="author-geo-box__header">
        <div>
          <span class="author-geo-box__eyebrow">
            <i class="bi bi-pen-fill" aria-hidden="true"></i> Người viết
          </span>
          <h4 class="author-geo-box__name" itemprop="name">{authorName}</h4>
        </div>
        <span class="author-geo-box__role" itemprop="jobTitle">{authorRole}</span>
      </div>

      <p class="author-geo-box__bio" itemprop="description">
        {authorBio}
      </p>

      <div class="author-geo-box__reviewers" aria-label="Hội đồng chuyên môn">
        <span class="author-geo-box__reviewer-item">
          <i class="bi bi-patch-check-fill author-geo-box__check" aria-hidden="true"></i>
          <span>Kiểm chứng y khoa: <strong>TS. BS. Minh Tâm</strong> (Ông chú ADHD)</span>
        </span>
        <span class="author-geo-box__reviewer-item">
          <i class="bi bi-patch-check-fill author-geo-box__check" aria-hidden="true"></i>
          <span>Kiểm chứng tài chính: <strong>Ông Phạm Minh</strong> (Cố vấn Tài chính Gia đình &amp; Chăm sóc Tại gia)</span>
        </span>
      </div>
    </div>
  </div>
</div>
