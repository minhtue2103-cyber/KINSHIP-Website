---
interface SourceItem {
  title: string;
  url: string;
}

interface Props {
  sources?: SourceItem[];
}

const { sources = [] } = Astro.props;
---

{sources && sources.length > 0 && (
  <section class="sources-section" aria-labelledby="sources-heading">
    <div class="sources-section__header">
      <span class="sources-section__icon" aria-hidden="true">📚</span>
      <h3 id="sources-heading" class="sources-section__title">
        Tài liệu &amp; Nguồn nghiên cứu thực chứng ({sources.length})
      </h3>
    </div>
    <ul class="sources-list">
      {sources.map((src, idx) => (
        <li class="sources-list__item">
          <span class="sources-list__index">[{idx + 1}]</span>
          <a
            href={src.url}
            target="_blank"
            rel="noopener noreferrer"
            class="sources-list__link"
          >
            <span>{src.title}</span>
            <span class="sources-list__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

