---
interface Props {
  quadrant?: 'Educate' | 'Inspire' | 'Entertain' | 'Convince' | string;
}

const { quadrant = 'Educate' } = Astro.props;

const quadrantMeta: Record<string, { label: string; iconClass: string; className: string }> = {
  Educate: { label: 'Educate', iconClass: 'bi bi-journal-medical', className: 'quadrant-badge--educate' },
  Inspire: { label: 'Inspire', iconClass: 'bi bi-heart-fill', className: 'quadrant-badge--inspire' },
  Entertain: { label: 'Entertain', iconClass: 'bi bi-cup-hot-fill', className: 'quadrant-badge--entertain' },
  Convince: { label: 'Convince', iconClass: 'bi bi-compass-fill', className: 'quadrant-badge--convince' },
};

const current = quadrantMeta[quadrant] || {
  label: quadrant,
  iconClass: 'bi bi-tree-fill',
  className: 'quadrant-badge--educate',
};
---

<span class={`quadrant-badge ${current.className}`}>
  <i class={`quadrant-badge__icon ${current.iconClass}`} aria-hidden="true"></i>
  <span>{current.label}</span>
</span>
