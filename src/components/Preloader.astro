---
import { MEDIA_ASSETS } from '../utils/media';
---

<!-- ===== GIÚP CHA MẸ: FIRST-VISIT PRELOADER & PAGE TRANSITION LOADER ===== -->
<div id="gcm-top-progress" class="gcm-top-progress" aria-hidden="true"></div>

<div id="gcm-preloader" role="status" aria-label="Đang tải trang Giúp Cha Mẹ">
  <div class="gcm-loader-wrap">
    
    <!-- Đồ họa SVG Chuyển động -->
    <svg class="gcm-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Gradient Xanh Lá Điểm Tựa (Bình an & Y khoa Thảo mộc) -->
        <linearGradient id="gcm-green-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#8dc435" />
          <stop offset="100%" stop-color="#428442" />
        </linearGradient>

        <!-- Gradient Cam Ấm Áp (Tình thân & Chở che) -->
        <linearGradient id="gcm-orange-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ff9046" />
          <stop offset="100%" stop-color="#e6782e" />
        </linearGradient>

        <!-- Vùng cắt hình tròn ôm sát Logo -->
        <clipPath id="gcm-logo-clip">
          <circle cx="100" cy="100" r="32" />
        </clipPath>

        <!-- Hiệu ứng tỏa sáng hào quang dịu -->
        <filter id="gcm-soft-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="2.5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Vòng sóng lan tỏa nhịp thở an lành -->
      <circle class="gcm-breath-ring" cx="100" cy="100" r="45" fill="none" stroke="#8dc435" stroke-width="1.5" />

      <!-- Vòng cung quỹ đạo ngoài: Điểm tựa của con cái (Xoay thuận) -->
      <g class="gcm-center gcm-arc-outer">
        <circle cx="100" cy="100" r="72" fill="none" stroke="rgba(66, 132, 66, 0.12)" stroke-width="4" />
        <circle cx="100" cy="100" r="72" fill="none" stroke="url(#gcm-green-grad)" stroke-width="5"
                stroke-dasharray="160 300" stroke-linecap="round" />
        <!-- Điểm kết nối hạt mầm xanh -->
        <circle cx="100" cy="28" r="5" fill="#428442" />
      </g>

      <!-- Vòng cung quỹ đạo trong: Chở che cho cha mẹ (Xoay ngược) -->
      <g class="gcm-center gcm-arc-inner">
        <circle cx="100" cy="100" r="54" fill="none" stroke="rgba(255, 144, 70, 0.14)" stroke-width="3" />
        <circle cx="100" cy="100" r="54" fill="none" stroke="url(#gcm-orange-grad)" stroke-width="4.5"
                stroke-dasharray="110 240" stroke-linecap="round" />
      </g>

      <!-- Logo nhận diện thương hiệu trung tâm -->
      <g class="gcm-center gcm-logo-core" filter="url(#gcm-soft-glow)">
        <!-- Viền tròn trắng làm nổi bật Logo -->
        <circle cx="100" cy="100" r="34" fill="#ffffff" stroke="rgba(141, 196, 53, 0.45)" stroke-width="2" />
        <image
          href={MEDIA_ASSETS.logo}
          x="68"
          y="68"
          width="64"
          height="64"
          clip-path="url(#gcm-logo-clip)"
          preserveAspectRatio="xMidYMid slice"
        />
      </g>
    </svg>

    <!-- Thông điệp thương hiệu -->
    <div class="gcm-brand-text">
      <div class="gcm-title">Giúp <strong>Cha Mẹ</strong></div>
      <div class="gcm-subtitle">Chăm sóc cha mẹ già nhẹ nhàng hơn</div>
      
      <!-- Thanh tiến trình mảnh -->
      <div class="gcm-progress-bar">
        <div class="gcm-progress-fill"></div>
      </div>
    </div>

  </div>
</div>

<style>
  /* 1. Thanh tiến trình đỉnh trang cho hiệu ứng chuyển trang (Top Progress Bar) */
  .gcm-top-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, #8dc435, #ff9046);
    z-index: 100000;
    pointer-events: none;
    transition: width 0.3s cubic-bezier(0.1, 0.9, 0.2, 1), opacity 0.2s ease;
    opacity: 0;
  }

  .gcm-top-progress.is-active {
    opacity: 1;
    width: 85%;
  }

  .gcm-top-progress.is-done {
    width: 100%;
    opacity: 0;
  }

  /* 2. Khung nền Preloader toàn màn hình - Tông Trắng & Xanh Kem Ấm dịu */
  #gcm-preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: radial-gradient(circle at center, #ffffff 0%, #f4fbe8 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.4s;
    pointer-events: auto;
  }

  /* Class ẩn sau khi tải xong */
  #gcm-preloader.gcm-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Chế độ Chuyển Trang Mềm (Page Transition Mode ~0.3s) */
  #gcm-preloader.gcm-transition {
    background: rgba(244, 251, 232, 0.92);
    backdrop-filter: blur(6px);
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  #gcm-preloader.gcm-transition .gcm-subtitle,
  #gcm-preloader.gcm-transition .gcm-progress-bar {
    display: none;
  }

  #gcm-preloader.gcm-transition .gcm-brand-text {
    margin-top: 8px;
  }

  .gcm-loader-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px;
  }

  .gcm-svg {
    width: 170px;
    height: 170px;
    overflow: visible;
  }

  .gcm-center {
    transform-origin: 100px 100px;
  }

  /* 3. Keyframes chuyển động */
  @keyframes gcmRotateRight {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes gcmRotateLeft {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(-360deg); }
  }

  @keyframes gcmLogoBreath {
    0%, 100% { transform: scale(0.96); }
    50% { transform: scale(1.04); }
  }

  @keyframes gcmBreathing {
    0% { r: 35px; opacity: 0.55; stroke-width: 2px; }
    100% { r: 88px; opacity: 0; stroke-width: 0.5px; }
  }

  @keyframes gcmFadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes gcmProgress {
    0% { width: 0%; }
    100% { width: 100%; }
  }

  /* 4. Áp dụng Animations */
  .gcm-arc-outer {
    animation: gcmRotateRight 4.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  }

  .gcm-arc-inner {
    animation: gcmRotateLeft 3.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  }

  .gcm-logo-core {
    animation: gcmLogoBreath 2.2s ease-in-out infinite;
  }

  .gcm-breath-ring {
    animation: gcmBreathing 2.8s ease-out infinite;
  }

  /* 5. Typography chuẩn thương hiệu */
  .gcm-brand-text {
    margin-top: 14px;
    animation: gcmFadeUp 0.6s ease-out forwards;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  .gcm-title {
    font-family: var(--font-heading, 'Merriweather', serif);
    font-size: 1.45rem;
    color: var(--text-primary, #374047);
    letter-spacing: -0.01em;
  }

  .gcm-title strong {
    color: var(--primary-dark, #428442);
    font-weight: 900;
  }

  .gcm-subtitle {
    margin-top: 6px;
    font-size: 0.88rem;
    color: var(--text-muted, #6c7983);
    font-weight: 400;
  }

  .gcm-progress-bar {
    margin: 16px auto 0;
    width: 140px;
    height: 3px;
    background: rgba(66, 132, 66, 0.15);
    border-radius: 99px;
    overflow: hidden;
  }

  .gcm-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #8dc435, #ff9046);
    border-radius: 99px;
    animation: gcmProgress 1.2s ease-out forwards;
  }
</style>

<script is:inline>
  (function() {
    const STORAGE_KEY = 'gcm_visited';
    const TRANSITION_KEY = 'gcm_page_transition';
    const preloader = document.getElementById('gcm-preloader');
    const topProgress = document.getElementById('gcm-top-progress');

    // 1. Kiểm tra trạng thái First-visit trong session
    const isFirstVisit = !sessionStorage.getItem(STORAGE_KEY);

    if (isFirstVisit) {
      // First Load: Hiển thị đầy đủ nhận diện thương hiệu ~1.1s
      const startTime = performance.now();
      const MIN_DISPLAY_TIME = 1100;

      function hideFirstLoader() {
        const elapsed = performance.now() - startTime;
        const remaining = Math.max(0, MIN_DISPLAY_TIME - elapsed);

        setTimeout(function() {
          if (preloader) {
            preloader.classList.add('gcm-hidden');
          }
          sessionStorage.setItem(STORAGE_KEY, 'true');
        }, remaining);
      }

      if (document.readyState === 'complete') {
        hideFirstLoader();
      } else {
        window.addEventListener('load', hideFirstLoader);
        setTimeout(hideFirstLoader, 2200); // Fallback an toàn phòng mạng chậm
      }
    } else {
      // Đã vào web trong phiên này:
      const wasTransitioning = sessionStorage.getItem(TRANSITION_KEY);
      if (wasTransitioning) {
        sessionStorage.removeItem(TRANSITION_KEY);
        // Hiệu ứng mờ dần hoàn tất chuyển cảnh nhanh (0.2s)
        if (preloader) {
          preloader.classList.add('gcm-transition');
          requestAnimationFrame(function() {
            setTimeout(function() {
              preloader.classList.add('gcm-hidden');
            }, 180);
          });
        }
      } else {
        // Tải trang trực tiếp hoặc Refresh: Ẩn tức thì để không ảnh hưởng LCP / SEO
        if (preloader) {
          preloader.classList.add('gcm-hidden');
        }
      }
    }

    // 2. Bắt sự kiện click các liên kết nội bộ để chuyển cảnh mềm (Smooth Page Transition)
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (!link) return;

      const href = link.getAttribute('href');
      if (!href) return;

      // Loại trừ các liên kết ngoài hoặc đặc biệt
      if (
        href.startsWith('#') ||
        href.startsWith('mailto:') ||
        href.startsWith('tel:') ||
        href.startsWith('javascript:') ||
        link.getAttribute('target') === '_blank' ||
        link.hasAttribute('download') ||
        e.ctrlKey || e.metaKey || e.shiftKey || e.altKey ||
        e.button !== 0
      ) {
        return;
      }

      // Kiểm tra cùng domain nội bộ
      try {
        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return;
        if (url.pathname === window.location.pathname && url.search === window.location.search) return;

        // Kích hoạt thanh top progress bar và lớp phủ chuyển cảnh mềm
        if (topProgress) {
          topProgress.classList.remove('is-done');
          topProgress.classList.add('is-active');
        }

        if (preloader) {
          preloader.classList.add('gcm-transition');
          preloader.classList.remove('gcm-hidden');
          sessionStorage.setItem(TRANSITION_KEY, 'true');
        }
      } catch (err) {
        // Bỏ qua nếu URL không hợp lệ
      }
    });

    // 3. Xử lý trường hợp người dùng ấn nút Back/Forward của trình duyệt (bfcache)
    window.addEventListener('pageshow', function(event) {
      if (event.persisted && preloader) {
        preloader.classList.add('gcm-hidden');
        if (topProgress) {
          topProgress.classList.remove('is-active');
          topProgress.classList.add('is-done');
        }
      }
    });
  })();
</script>

