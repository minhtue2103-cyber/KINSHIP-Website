---
import '../styles/global.css';
import { MEDIA_ASSETS } from '../utils/media';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  faqSchema?: Record<string, any> | null;
  ogType?: string;
  ogImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = 'Kinship AI — Cổng thông tin & đồng hành cùng thế hệ Bánh Mì Kẹp chăm sóc cha mẹ già tại gia.',
  faqSchema = null,
  ogType = 'website',
  ogImage = MEDIA_ASSETS.defaultFeaturePhoto,
  pubDate,
  updatedDate,
  breadcrumbs = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://kinship-website.pages.dev';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const currentPath = Astro.url.pathname;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Kinship AI',
  url: siteOrigin,
  logo: `${siteOrigin}${MEDIA_ASSETS.logo}`,
  description: 'Nền tảng tri thức và đồng hành vi mô dành cho thế hệ Bánh Mì Kẹp chăm sóc cha mẹ già tại Việt Nam.',
};

const articleSchema =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: [ogImage],
        datePublished: pubDate ? new Date(pubDate).toISOString() : undefined,
        dateModified: updatedDate
          ? new Date(updatedDate).toISOString()
          : pubDate
          ? new Date(pubDate).toISOString()
          : undefined,
        author: {
          '@type': 'Person',
          name: 'Nhung Pham',
          jobTitle: 'Founder & Caregiver Advocate',
        },
        reviewedBy: [
          {
            '@type': 'Person',
            name: 'TS. BS. Tâm',
            jobTitle: 'Chuyên gia Tâm lý Lão khoa',
          },
          {
            '@type': 'Person',
            name: 'Ông Minh',
            jobTitle: 'Chuyên gia Quản trị Tài chính Gia đình',
          },
        ],
        publisher: {
          '@type': 'Organization',
          name: 'Kinship AI',
          logo: {
            '@type': 'ImageObject',
            url: `${siteOrigin}${MEDIA_ASSETS.logo}`,
          },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL,
        },
      }
    : null;

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: item.name,
          item: item.url.startsWith('http') ? item.url : `${siteOrigin}${item.url}`,
        })),
      }
    : null;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={MEDIA_ASSETS.favicon} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | Kinship AI</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Kinship AI" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data JSON-LD (GEO / SEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-logo" aria-label="Kinship AI Trang chủ">
          <img
            src={MEDIA_ASSETS.logo}
            alt="Kinship AI Logo"
            class="brand-logo__img"
            width="36"
            height="36"
          />
          <span class="brand-name">Kinship <strong>AI</strong></span>
        </a>

        <nav class="nav-links" aria-label="Điều hướng chính">
          <a href="/" class={currentPath === '/' ? 'nav-link active' : 'nav-link'}>
            Trang chủ
          </a>
          <a
            href="/blog"
            class={currentPath.startsWith('/blog') ? 'nav-link active' : 'nav-link'}
          >
            Caregiver Blog
          </a>
          <a href="/#hoi-dong-chuyen-gia" class="nav-link">
            Hội đồng Chuyên gia
          </a>
        </nav>

        <div class="header-cta">
          <a href="#cam-nang-vi-mo" class="btn btn--accent btn--sm">
            Cẩm nang chăm sóc
          </a>
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-col footer-col--brand">
          <a href="/" class="brand-logo">
            <img
              src={MEDIA_ASSETS.logo}
              alt="Kinship AI Logo"
              class="brand-logo__img"
              width="34"
              height="34"
            />
            <span class="brand-name">Kinship <strong>AI</strong></span>
          </a>
          <p class="footer-desc">
            Đồng hành cùng thế hệ Bánh Mì Kẹp (35–55 tuổi) thấu hiểu tâm lý lão khoa, quản trị tài chính gia đình và thiết kế hệ thống chăm sóc cha mẹ già tại gia bền vững (Aging in Place).
          </p>
          <p class="footer-disclaimer">
            <strong>Tuyên bố miễn trừ y tế:</strong> Nội dung trên Kinship AI mang tính chất giáo dục, tham khảo tâm lý &amp; hoạch định đời sống gia đình, không thay thế chẩn đoán hay chỉ định điều trị y khoa.
          </p>
        </div>

        <div class="footer-col footer-links-col">
          <h4>Bản đồ Website (Sitemap)</h4>
          <ul>
            <li><a href="/">1. Trang chủ (Homepage)</a></li>
            <li><a href="/blog">2. Caregiver Blog (Tất cả bài viết)</a></li>
            <li><a href="/#hoi-dong-chuyen-gia">Hội đồng Cố vấn E-E-A-T</a></li>
            <li><a href="#cam-nang-vi-mo">Cẩm nang Đồng hành Vi mô</a></li>
          </ul>
        </div>

        <div class="footer-col footer-links-col">
          <h4>Ma trận Nội dung Umbrex</h4>
          <ul>
            <li><a href="/blog?quadrant=Educate">📚 Kiến thức Lão khoa &amp; Tài chính (Educate)</a></li>
            <li><a href="/blog?quadrant=Inspire">❤️ Cảm xúc &amp; Tình thân (Inspire)</a></li>
            <li><a href="/blog?quadrant=Entertain">☕ Khoảng cách Thế hệ (Entertain)</a></li>
            <li><a href="/blog?quadrant=Convince">🎯 Giải pháp Vi mô (Convince)</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom container">
        <p>© {new Date().getFullYear()} Kinship AI. Mọi quyền được bảo lưu. Cầu nối gia đình &amp; Đồng hành vi mô.</p>
      </div>
    </footer>
  </body>
</html>
