---
interface Props {
  title: string;
  description?: string;
  faqSchema?: Record<string, any> | null;
  ogType?: string;
}

const {
  title,
  description = "Kinship AI — Nền tảng đồng hành cùng thế hệ Bánh Mì Kẹp chăm sóc cha mẹ già tại gia.",
  faqSchema = null,
  ogType = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://kinship-website.pages.dev");
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | Kinship AI</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Kinship AI" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Schema.org JSON-LD (FAQ / Article) -->
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-logo">
          <span class="brand-icon">🌱</span>
          <span class="brand-name">Kinship <strong>AI</strong></span>
        </a>
        <nav class="nav-links">
          <a href="/">Trang chủ</a>
          <a href="/#bai-viet">Bài viết</a>
          <a href="/#ve-kinship">Về chúng tôi</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-col">
          <div class="brand-logo">
            <span class="brand-icon">🌱</span>
            <span class="brand-name">Kinship <strong>AI</strong></span>
          </div>
          <p class="footer-desc">
            Đồng hành cùng người con tuổi 35–55 thấu hiểu tâm lý lão khoa, quản trị tài chính gia đình và thiết kế hệ thống chăm sóc cha mẹ bền vững.
          </p>
        </div>
        <div class="footer-col footer-links-col">
          <h4>Chủ đề chính</h4>
          <ul>
            <li><a href="/?quadrant=Educate">Kiến thức Lão khoa (Educate)</a></li>
            <li><a href="/?quadrant=Inspire">Tình cảm Gia đình (Inspire)</a></li>
            <li><a href="/?quadrant=Entertain">Khoảng cách Thế hệ (Entertain)</a></li>
            <li><a href="/?quadrant=Convince">Hành động Vi mô (Convince)</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom container">
        <p>© {new Date().getFullYear()} Kinship AI. Mọi quyền được bảo lưu. Tác vụ phi y tế & Cầu nối gia đình.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary: #0f766e;
    --primary-hover: #115e59;
    --primary-light: #f0fdfa;
    --primary-border: #99f6e4;
    --text-main: #0f172a;
    --text-muted: #475569;
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --border: #e2e8f0;
    --radius: 12px;
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-sans);
    color: var(--text-main);
    background-color: var(--bg-main);
    line-height: 1.7;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  a {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--primary-hover);
  }

  /* Header */
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
    background: rgba(255, 255, 255, 0.95);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.35rem;
    color: var(--text-main);
  }

  .brand-icon {
    font-size: 1.6rem;
  }

  .brand-logo strong {
    color: var(--primary);
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
    font-weight: 500;
  }

  .nav-links a {
    color: var(--text-muted);
  }

  .nav-links a:hover {
    color: var(--primary);
  }

  /* Main */
  .site-main {
    flex: 1;
    padding: 2.5rem 0 4rem;
  }

  /* Footer */
  .site-footer {
    background: #ffffff;
    border-top: 1px solid var(--border);
    padding: 3.5rem 0 2rem;
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  .footer-desc {
    color: var(--text-muted);
    margin-top: 0.75rem;
    font-size: 0.95rem;
    max-width: 500px;
  }

  .footer-links-col h4 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .footer-links-col ul {
    list-style: none;
  }

  .footer-links-col li {
    margin-bottom: 0.5rem;
  }

  .footer-links-col a {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  /* Typography for Markdown Prose */
  .prose {
    font-size: 1.05rem;
    color: #1e293b;
    line-height: 1.8;
  }

  .prose h2 {
    font-size: 1.65rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    color: #0f172a;
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .prose h3 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: #1e293b;
  }

  .prose p {
    margin-bottom: 1.4rem;
  }

  .prose ul, .prose ol {
    margin: 1rem 0 1.5rem 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  /* Obsidian Callout (> [!SUMMARY] BLUF: ...) */
  .prose blockquote {
    background: #f0fdf4;
    border-left: 4px solid #16a34a;
    padding: 1.15rem 1.4rem;
    border-radius: 0 10px 10px 0;
    margin: 1.75rem 0;
    color: #14532d;
    font-size: 1.02rem;
  }

  .prose hr {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 2.5rem 0;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .header-inner {
      height: 60px;
    }
  }
</style>
