---
import '../styles/global.css';
import { MEDIA_ASSETS, SOCIAL_LINKS } from '../utils/media';
import { QUADRANT_SETTINGS } from '../utils/taxonomy';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  faqSchema?: Record<string, any> | null;
  ogType?: string;
  ogImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = 'Kiến thức y khoa dễ hiểu từ TS.BS Tâm, bài toán tài chính chăm sóc tại nhà từ Ông Minh và công cụ đồng hành giúp bạn chăm sóc cha mẹ mà không kiệt sức.',
  faqSchema = null,
  ogType = 'website',
  ogImage = MEDIA_ASSETS.defaultFeaturePhoto,
  pubDate,
  updatedDate,
  breadcrumbs = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://kinship-website.pages.dev';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const currentPath = Astro.url.pathname;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Giúp Cha Mẹ',
  url: siteOrigin,
  logo: `${siteOrigin}${MEDIA_ASSETS.logo}`,
  sameAs: [SOCIAL_LINKS.facebook, SOCIAL_LINKS.youtube],
  description: 'Điểm tựa thực tế cho người trưởng thành giữa hai đầu gánh nặng: giữ sức khỏe tinh thần cho mình và chăm sóc cha mẹ già tại nhà.',
};

const articleSchema =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: [ogImage],
        datePublished: pubDate ? new Date(pubDate).toISOString() : undefined,
        dateModified: updatedDate
          ? new Date(updatedDate).toISOString()
          : pubDate
          ? new Date(pubDate).toISOString()
          : undefined,
        author: {
          '@type': 'Person',
          name: 'Nhung Phạm',
          jobTitle: 'Đồng sáng lập dự án Giúp Cha Mẹ',
        },
        reviewedBy: [
          {
            '@type': 'Person',
            name: 'TS. BS. Tâm',
            jobTitle: 'Chuyên gia Tâm lý & Sức khỏe Lão khoa (Ông chú ADHD)',
          },
          {
            '@type': 'Person',
            name: 'Ông Minh',
            jobTitle: 'Cố vấn Tài chính Gia đình & Dịch vụ Chăm sóc Tại gia',
          },
        ],
        publisher: {
          '@type': 'Organization',
          name: 'Giúp Cha Mẹ',
          logo: {
            '@type': 'ImageObject',
            url: `${siteOrigin}${MEDIA_ASSETS.logo}`,
          },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL,
        },
      }
    : null;

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: item.name,
          item: item.url.startsWith('http') ? item.url : `${siteOrigin}${item.url}`,
        })),
      }
    : null;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href={MEDIA_ASSETS.favicon} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | Giúp Cha Mẹ</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Raleway (Body) & Noto Sans (Heading) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,500;0,600;0,700;0,800;1,400&family=Raleway:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons CDN -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Giúp Cha Mẹ" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data JSON-LD (GEO / SEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-logo" aria-label="Giúp Cha Mẹ Trang chủ">
          <img
            src={MEDIA_ASSETS.logo}
            alt="Giúp Cha Mẹ Logo"
            class="brand-logo__img"
            width="48"
            height="48"
          />
          <div class="brand-text-block">
            <span class="brand-name">Giúp <strong>Cha Mẹ</strong></span>
            <span class="brand-tagline">Chăm sóc cha mẹ già nhẹ nhàng hơn</span>
          </div>
        </a>

        <div class="header-actions">
          <!-- Social Media Icons on Header -->
          <div class="header-socials" aria-label="Mạng xã hội">
            <a
              href={SOCIAL_LINKS.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Facebook Ông chú ADHD - Chuyện tuổi trung niên"
              title="Facebook: Ông chú ADHD"
            >
              <i class="bi bi-facebook" aria-hidden="true"></i>
            </a>
            <a
              href={SOCIAL_LINKS.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link social-icon-link--yt"
              aria-label="YouTube Sức khỏe Tuổi Trung Niên"
              title="YouTube: Sức Khỏe Tuổi Trung Niên"
            >
              <i class="bi bi-youtube" aria-hidden="true"></i>
            </a>
          </div>

          <!-- Click to Open/Close Menu Button (MekongDeltaAgri Style) -->
          <button
            type="button"
            id="menu-toggle-btn"
            class="menu-toggle-btn"
            aria-expanded="false"
            aria-controls="site-drawer-menu"
            aria-label="Mở hoặc đóng menu điều hướng"
          >
            <i class="bi bi-list menu-toggle-btn__icon-open" aria-hidden="true"></i>
            <i class="bi bi-x-lg menu-toggle-btn__icon-close" aria-hidden="true"></i>
            <span class="menu-toggle-btn__label">MENU</span>
          </button>
        </div>
      </div>

      <!-- Click-to-open/close Slide Drawer Menu & Overlay -->
      <div id="menu-backdrop" class="menu-backdrop" aria-hidden="true"></div>
      <nav
        id="site-drawer-menu"
        class="site-drawer-menu"
        aria-label="Điều hướng chính"
        aria-hidden="true"
      >
        <div class="site-drawer-menu__header">
          <a href="/" class="brand-logo">
            <img
              src={MEDIA_ASSETS.logo}
              alt="Giúp Cha Mẹ Logo"
              class="brand-logo__img"
              width="40"
              height="40"
            />
            <div class="brand-text-block">
              <span class="brand-name">Giúp <strong>Cha Mẹ</strong></span>
              <span class="brand-tagline">Chăm sóc cha mẹ già nhẹ nhàng hơn</span>
            </div>
          </a>
          <button
            type="button"
            id="menu-close-btn"
            class="menu-close-btn"
            aria-label="Đóng menu"
          >
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>
        </div>

        <div class="site-drawer-menu__body">
          <span class="site-drawer-menu__section-label">Điều hướng chính</span>
          <ul class="drawer-nav-list">
            <li>
              <a href="/" class={currentPath === '/' ? 'drawer-nav-link active' : 'drawer-nav-link'}>
                <i class="bi bi-house-heart-fill" aria-hidden="true"></i>
                <span>Trang chủ</span>
              </a>
            </li>
            <li>
              <a
                href="/cam-nang-cham-soc"
                class={currentPath === '/cam-nang-cham-soc' ? 'drawer-nav-link active' : 'drawer-nav-link'}
              >
                <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i>
                <span>Cẩm Nang Chăm Sóc Cho Mẹ</span>
              </a>
            </li>
            <li>
              <a
                href="/blog"
                class={currentPath.startsWith('/blog') ? 'drawer-nav-link active' : 'drawer-nav-link'}
              >
                <i class="bi bi-journal-richtext" aria-hidden="true"></i>
                <span>Cẩm nang Chăm sóc</span>
              </a>
            </li>
            <li>
              <a href="/#bai-viet" class="drawer-nav-link">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <span>Bài viết Tiêu điểm</span>
              </a>
            </li>
            <li>
              <a href="/#hoi-dong-chuyen-gia" class="drawer-nav-link">
                <i class="bi bi-people-fill" aria-hidden="true"></i>
                <span>Người Đồng Hành Cùng Bạn</span>
              </a>
            </li>
            <li>
              <a href="#ve-chung-toi" class="drawer-nav-link">
                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                <span>Về Chúng Tôi</span>
              </a>
            </li>
            <li>
              <a href="#cam-nang-vi-mo" class="drawer-nav-link">
                <i class="bi bi-book-half" aria-hidden="true"></i>
                <span>Cẩm nang Gia đình Miễn phí</span>
              </a>
            </li>
          </ul>

          <span class="site-drawer-menu__section-label">Chủ đề bài viết</span>
          <ul class="drawer-nav-list drawer-nav-list--sub">
            {
              Object.values(QUADRANT_SETTINGS).map((q) => (
                <li>
                  <a href={`/blog?quadrant=${q.key}`} class="drawer-nav-link">
                    <i class={q.iconClass} aria-hidden="true"></i>
                    <span>{q.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="site-drawer-menu__footer">
            <span class="site-drawer-menu__section-label">Kênh vệ tinh chia sẻ</span>
            <div class="drawer-socials">
              <a
                href={SOCIAL_LINKS.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="drawer-social-btn"
                title="Facebook: Ông chú ADHD"
              >
                <i class="bi bi-facebook" aria-hidden="true"></i>
                <span>Facebook BS. Tâm</span>
              </a>
              <a
                href={SOCIAL_LINKS.youtube}
                target="_blank"
                rel="noopener noreferrer"
                class="drawer-social-btn drawer-social-btn--yt"
                title="YouTube: Sức Khỏe Tuổi Trung Niên"
              >
                <i class="bi bi-youtube" aria-hidden="true"></i>
                <span>YouTube</span>
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-col footer-col--brand">
          <a href="/" class="brand-logo" aria-label="Giúp Cha Mẹ">
            <img
              src={MEDIA_ASSETS.logo}
              alt="Giúp Cha Mẹ Logo"
              class="brand-logo__img"
              width="44"
              height="44"
            />
            <div class="brand-text-block">
              <span class="brand-name">Giúp <strong>Cha Mẹ</strong></span>
              <span class="brand-tagline">Chăm sóc cha mẹ già nhẹ nhàng hơn</span>
            </div>
          </a>
          <p class="footer-desc">
            Chăm sóc cha mẹ già là chặng đường dài hạn, đòi hỏi sự chuẩn bị thực tế thay vì âm thầm gánh vác một mình. Để giữ tròn trách nhiệm mà không kiệt sức, gia đình cần chủ động chuẩn bị quỹ y tế dự phòng.
            Quan trọng nhất, bạn phải giữ sức khỏe và tinh thần thật vững vàng thì mới có thể làm chỗ dựa an tâm cho cha mẹ.
          </p>
          <p class="footer-disclaimer">
            <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
            <strong>Bản quyền nội dung:</strong> Nội dung mang tính chất chia sẻ kinh nghiệm, kiến thức y khoa đại chúng và hoạch định đời sống gia đình, không thay thế chẩn đoán hay chỉ định điều trị y khoa trực tiếp từ bác sĩ.
          </p>

          <div class="footer-socials" aria-label="Liên kết Mạng xã hội">
            <a
              href={SOCIAL_LINKS.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social-link"
              aria-label="Facebook Ông chú ADHD"
            >
              <i class="bi bi-facebook" aria-hidden="true"></i>
              <span>Facebook BS. Tâm</span>
            </a>
            <a
              href={SOCIAL_LINKS.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social-link footer-social-link--yt"
              aria-label="YouTube Sức Khỏe Tuổi Trung Niên"
            >
              <i class="bi bi-youtube" aria-hidden="true"></i>
              <span>YouTube Tuổi Trung Niên</span>
            </a>
          </div>
        </div>

        <div class="footer-col footer-links-col">
          <h4>Sitemap</h4>
          <ul>
            <li>
              <a href="/">
                Trang chủ (Homepage)
              </a>
            </li>
            <li>
              <a href="/cam-nang-cham-soc">
                Cẩm Nang Chăm Sóc Cho Mẹ
              </a>
            </li>
            <li>
              <a href="/blog">
                Cẩm nang Chăm sóc Cha mẹ tại nhà
              </a>
            </li>
            <li>
              <a href="/#hoi-dong-chuyen-gia">
                Hội đồng Cố vấn: TS. BS. Tâm &amp; Ông Minh
              </a>
            </li>
            <li>
              <a href="#ve-chung-toi">
                Về chúng tôi
              </a>
            </li>
            <li>
              <a href="#cam-nang-vi-mo">
                 Cẩm nang Hướng dẫn Thực hành
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-col footer-links-col">
          <h4>Chủ đề theo góc nhìn</h4>
          <ul>
            {
              Object.values(QUADRANT_SETTINGS).map((q) => (
                <li>
                  <a href={`/blog?quadrant=${q.key}`}>
                    <i class={q.iconClass} aria-hidden="true"></i> {q.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="footer-bottom container">
        <p>© {new Date().getFullYear()} Giúp Cha Mẹ (giupchame.info.vn). All Rights Reserved. Website chính thức: <a href="https://giupchame.info.vn/" target="_blank" rel="noopener noreferrer">https://giupchame.info.vn/</a></p>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('menu-toggle-btn');
        const closeBtn = document.getElementById('menu-close-btn');
        const drawer = document.getElementById('site-drawer-menu');
        const backdrop = document.getElementById('menu-backdrop');

        function setMenuOpen(open) {
          if (!toggleBtn || !drawer || !backdrop) return;
          toggleBtn.classList.toggle('is-open', open);
          drawer.classList.toggle('is-open', open);
          backdrop.classList.toggle('is-open', open);
          toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
          document.body.style.overflow = open ? 'hidden' : '';
        }

        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            const isOpen = drawer && drawer.classList.contains('is-open');
            setMenuOpen(!isOpen);
          });
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', () => setMenuOpen(false));
        }

        if (backdrop) {
          backdrop.addEventListener('click', () => setMenuOpen(false));
        }

        if (drawer) {
          const links = drawer.querySelectorAll('a');
          links.forEach((link) => {
            link.addEventListener('click', () => setMenuOpen(false));
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            setMenuOpen(false);
          }
        });
      });
    </script>
  </body>
</html>
