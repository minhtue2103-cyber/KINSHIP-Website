---
import Layout from '../../layouts/Layout.astro';
import QuadrantBadge from '../../components/QuadrantBadge.astro';
import AuthorGeoBox from '../../components/AuthorGeoBox.astro';
import FeaturePhoto from '../../components/FeaturePhoto.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import SourcesList from '../../components/SourcesList.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticleFeaturePhoto } from '../../utils/media';
import { getQuadrantConfig } from '../../utils/taxonomy';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      relatedPosts: posts.filter((p) => p.slug !== post.slug).slice(0, 3),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, relatedPosts = [] } = Astro.props;
const { Content, headings } = await post.render();

const tocHeadings = headings.filter(
  (h) => h.depth === 2 && !h.text.toLowerCase().includes('tài liệu & nguồn tham khảo')
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('vi-VN', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  }).format(new Date(date));
}

const faqEntities = post.data.faqSchema?.mainEntity || [];
const displayDate = post.data.updatedDate || post.data.pubDate;
const cleanTags = (post.data.tags || [])
  .map((t) => t.replace(/^kinship\//, ''))
  .filter((t) => t !== 'content' && t !== 'UmbrexMatrix');

const featurePhotoUrl = getArticleFeaturePhoto(
  post.data.featurePhoto,
  post.slug,
  post.data.quadrant
);

const featureCaption =
  post.data.featureCaption ||
  `Ảnh minh họa: ${post.data.title} — Bản quyền nội dung thực chứng thuộc Kinship AI.`;

const quadrantName = post.data.quadrant ? getQuadrantConfig(post.data.quadrant).label : '';

const breadcrumbs = [
  { name: 'Trang chủ', url: '/' },
  { name: 'Cẩm nang Chăm sóc', url: '/blog' },
  ...(post.data.quadrant
    ? [{ name: quadrantName, url: `/blog?quadrant=${post.data.quadrant}` }]
    : []),
  { name: post.data.title, url: `/blog/${post.slug}` },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  faqSchema={post.data.faqSchema}
  ogType="article"
  ogImage={featurePhotoUrl}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  breadcrumbs={breadcrumbs}
>
  <article class="container article-detail">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">
        <i class="bi bi-house-door" aria-hidden="true"></i> Trang chủ
      </a>
      <i class="bi bi-chevron-right breadcrumb__sep" aria-hidden="true"></i>
      <a href="/blog">Cẩm nang Chăm sóc</a>
      {post.data.quadrant && (
        <>
          <i class="bi bi-chevron-right breadcrumb__sep" aria-hidden="true"></i>
          <a href={`/blog?quadrant=${post.data.quadrant}`}>{quadrantName}</a>
        </>
      )}
      <i class="bi bi-chevron-right breadcrumb__sep" aria-hidden="true"></i>
      <span class="breadcrumb__current">{post.data.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="article-header">
      <div class="article-header__badges">
        <QuadrantBadge quadrant={post.data.quadrant} />
        <span class="article-card__meta-sep" aria-hidden="true">•</span>
        <time class="article-header__date" datetime={new Date(displayDate).toISOString()}>
          <i class="bi bi-calendar3" aria-hidden="true"></i> Cập nhật: {formatDate(displayDate)}
        </time>
        <span class="article-card__meta-sep" aria-hidden="true">•</span>
        <span class="article-header__reading">
          <i class="bi bi-clock" aria-hidden="true"></i> {post.data.readingTime || 8} phút đọc
        </span>
      </div>

      <h1 class="article-header__title">{post.data.title}</h1>
      <p class="article-header__lead">{post.data.description}</p>

      {cleanTags.length > 0 && (
        <div class="article-header__tags">
          {cleanTags.map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Khối Author Dành Riêng Cho GEO (Div Author & E-E-A-T Card) -->
    <AuthorGeoBox />

    <!-- Feature Photo Bắt Buộc (1200x630 px) -->
    <FeaturePhoto
      src={post.data.featurePhoto}
      alt={post.data.title}
      caption={featureCaption}
      slug={post.slug}
      quadrant={post.data.quadrant}
    />

    <!-- Body Layout: Sticky TOC Left + 820px Prose Content Right -->
    <div class="article-layout-grid">
      {tocHeadings.length > 0 && (
        <aside class="article-sidebar" aria-label="Mục lục bài viết">
          <div class="sticky-toc">
            <h3 class="sticky-toc__title">
              <i class="bi bi-list-columns-reverse" aria-hidden="true"></i> Mục lục bài viết
            </h3>
            <ul class="sticky-toc__list">
              {tocHeadings.map((h) => (
                <li class="sticky-toc__item">
                  <a href={`#${h.slug}`} class="sticky-toc__link">
                    {h.text}
                  </a>
                </li>
              ))}
              {faqEntities.length > 0 && (
                <li class="sticky-toc__item">
                  <a href="#faq-section-heading" class="sticky-toc__link">
                    <i class="bi bi-patch-question" aria-hidden="true"></i> Câu hỏi thường gặp (FAQ)
                  </a>
                </li>
              )}
              {post.data.sources && post.data.sources.length > 0 && (
                <li class="sticky-toc__item">
                  <a href="#sources-heading" class="sticky-toc__link">
                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i> Tài liệu &amp; Nguồn tham khảo
                  </a>
                </li>
              )}
            </ul>

            <div class="sticky-mini-cta">
              <span class="sticky-mini-cta__badge">
                <i class="bi bi-heart-pulse-fill" aria-hidden="true"></i> Điểm tựa đồng hành
              </span>
              <p class="sticky-mini-cta__text">
                Cần phương án chăm sóc cha mẹ phù hợp hoàn cảnh gia đình?
              </p>
              <a href="/cam-nang-cham-soc" class="btn btn--accent btn--sm btn--full">
                Tải Bản Hướng Dẫn
              </a>
            </div>
          </div>
        </aside>
      )}

      <div class="article-main-col">
        <!-- Markdown Content Body -->
        <div class="prose post-body" id="article-prose-body">
          <Content />
        </div>

        <!-- Contextual Call To Action Box -->
        <div id="cam-nang-vi-mo" class="contextual-cta-box">
          <div class="contextual-cta-box__badge">
            <i class="bi bi-lightbulb-fill" aria-hidden="true"></i> Điểm tựa từ Giúp Cha Mẹ
          </div>
          <h3 class="contextual-cta-box__title">
            Chăm sóc cha mẹ già mà không làm khổ chính mình
          </h3>
          <p class="contextual-cta-box__desc">
            Tải miễn phí <strong>"Bản hướng dẫn ngồi lại đối thoại cùng gia đình và thiết lập phương án có người phụ giúp tại nhà"</strong> do TS.BS Tâm &amp; Cố vấn tài chính Ông Minh biên soạn.
          </p>
          <a href="/cam-nang-cham-soc" class="btn btn--accent">
            <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i>
            <span>Tải Cẩm Nang Chăm Sóc Cho Mẹ</span>
          </a>
        </div>

        <!-- Interactive FAQ Section (Schema.org / Google GEO) -->
        <FaqAccordion faqEntities={faqEntities} />

        <!-- Public Sources Section -->
        <SourcesList sources={post.data.sources} />
      </div>
    </div>
  </article>

  <!-- Bài viết cùng chủ đề (Related Articles) -->
  {relatedPosts.length > 0 && (
    <section class="container related-articles-section">
      <div class="section-header-row">
        <div>
          <span class="section-eyebrow">
            <i class="bi bi-bookmarks-fill" aria-hidden="true"></i> Đọc tiếp chủ đề liên quan
          </span>
          <h2 class="section-title">Bài viết cùng chủ đề dành cho bạn</h2>
        </div>
        <a href="/blog" class="btn btn--outline btn--sm">
          <span>Xem toàn bộ Blog</span>
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="posts-grid">
        {relatedPosts.map((rel) => (
          <ArticleCard
            title={rel.data.title}
            description={rel.data.description}
            slug={rel.slug}
            pubDate={rel.data.pubDate}
            quadrant={rel.data.quadrant}
            tags={rel.data.tags}
            thumbnailUrl={rel.data.thumbnail}
            readingTime={rel.data.readingTime || 8}
          />
        ))}
      </div>
    </section>
  )}

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const prose = document.getElementById('article-prose-body');
      if (!prose) return;

      // 1. Nâng cấp định dạng khối > [!SUMMARY] BLUF: thành Callout chuẩn GEO kèm Bootstrap Icon
      const blockquotes = prose.querySelectorAll('blockquote');
      blockquotes.forEach((bq) => {
        const html = bq.innerHTML;
        if (html.includes('[!SUMMARY]') || html.includes('BLUF:') || html.includes('Bạn có biết..')) {
          bq.classList.add('bluf-callout');
          const cleanHtml = html
            .replace(/\[!SUMMARY\]\s*/gi, '')
            .replace(/<p>\s*(?:BLUF:|Tóm tắt trực diện \(BLUF\)|Bạn có biết\.{2,}:?)\s*/gi, '<p>');
          bq.innerHTML =
            '<div class="bluf-callout__badge"><i class="bi bi-lightbulb-fill" aria-hidden="true"></i><span>Bạn có biết..</span></div>' +
            '<div class="bluf-callout__text">' +
            cleanHtml +
            '</div>';
        }
      });

      // 2. Ẩn mục "## Tài liệu & Nguồn tham khảo" trùng lặp trong Markdown vì đã có component SourcesList chuẩn hóa bên dưới
      const headings = prose.querySelectorAll('h2');
      headings.forEach((h2) => {
        if (h2.textContent && h2.textContent.toLowerCase().includes('tài liệu & nguồn tham khảo')) {
          const nextEl = h2.nextElementSibling;
          if (nextEl && nextEl.tagName === 'UL') {
            nextEl.style.display = 'none';
          }
          h2.style.display = 'none';
        }
      });
    });
  </script>
</Layout>
