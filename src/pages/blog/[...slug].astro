---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('vi-VN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(new Date(date));
}

const faqEntities = post.data.faqSchema?.mainEntity || [];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  faqSchema={post.data.faqSchema}
  ogType="article"
>
  <article class="container post-container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Trang chủ</a>
      <span class="separator">/</span>
      <a href="/#bai-viet">Blog</a>
      <span class="separator">/</span>
      <span class="current">{post.data.title}</span>
    </nav>

    <!-- Post Header -->
    <header class="post-header">
      <div class="header-badges">
        {post.data.quadrant && (
          <span class="quadrant-badge">{post.data.quadrant}</span>
        )}
        <time class="post-date" datetime={new Date(post.data.pubDate).toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </div>

      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-lead">{post.data.description}</p>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <span class="tag-pill">#{tag.replace('kinship/', '')}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Post Body (Markdown Content) -->
    <div class="prose post-body">
      <Content />
    </div>

    <!-- Interactive FAQ Section (Schema.org / Google GEO Preview) -->
    {faqEntities && faqEntities.length > 0 && (
      <section class="faq-section">
        <h2 class="faq-title">Câu hỏi thường gặp (FAQ)</h2>
        <div class="faq-list">
          {faqEntities.map((faq: any) => (
            <details class="faq-item">
              <summary class="faq-question">{faq.name}</summary>
              <div class="faq-answer">
                <p>{faq.acceptedAnswer?.text}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Public Sources Section -->
    {post.data.sources && post.data.sources.length > 0 && (
      <section class="sources-section">
        <h3 class="sources-title">Tài liệu & Nguồn nghiên cứu tham khảo</h3>
        <ul class="sources-list">
          {post.data.sources.map((src) => (
            <li>
              <a href={src.url} target="_blank" rel="noopener noreferrer">
                {src.title} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Navigation Back -->
    <footer class="post-nav-footer">
      <a href="/" class="back-link">← Quay lại danh sách bài viết</a>
    </footer>
  </article>
</Layout>

<style>
  .post-container {
    max-width: 820px;
    padding-top: 1rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: #64748b;
    margin-bottom: 2rem;
    white-space: nowrap;
    overflow-x: auto;
  }

  .breadcrumb .separator {
    color: #cbd5e1;
  }

  .breadcrumb .current {
    color: #0f172a;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-header {
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .quadrant-badge {
    background: #ccfbf1;
    color: #0f766e;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-date {
    font-size: 0.9rem;
    color: #64748b;
  }

  .post-title {
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.3;
    color: #0f172a;
    margin-bottom: 1.25rem;
  }

  .post-lead {
    font-size: 1.15rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    background: #f1f5f9;
    color: #475569;
    font-size: 0.82rem;
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
  }

  .post-body {
    margin-bottom: 3.5rem;
  }

  /* FAQ Accordion */
  .faq-section {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 2rem;
    margin: 3.5rem 0;
  }

  .faq-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    transition: background-color 0.2s ease;
  }

  .faq-item[open] {
    background: #ffffff;
    border-color: #0f766e;
  }

  .faq-question {
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.35rem;
    font-weight: 400;
    color: #0f766e;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-question::after {
    content: '−';
    transform: rotate(180deg);
  }

  .faq-answer {
    margin-top: 0.85rem;
    color: #334155;
    font-size: 0.98rem;
    line-height: 1.7;
    border-top: 1px solid #e2e8f0;
    padding-top: 0.85rem;
  }

  /* Sources Section */
  .sources-section {
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 3rem;
  }

  .sources-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.75rem;
  }

  .sources-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sources-list li a {
    font-size: 0.92rem;
    color: #0f766e;
    word-break: break-all;
  }

  .sources-list li a:hover {
    text-decoration: underline;
  }

  .post-nav-footer {
    border-top: 1px solid #e2e8f0;
    padding-top: 2rem;
    margin-top: 2rem;
  }

  .back-link {
    font-weight: 600;
    font-size: 0.98rem;
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 1.75rem;
    }
    .faq-section {
      padding: 1.25rem;
    }
  }
</style>
