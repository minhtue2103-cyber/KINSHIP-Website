---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { MEDIA_ASSETS } from '../../utils/media';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const breadcrumbs = [
  { name: 'Trang chủ', url: '/' },
  { name: 'Cẩm nang Chăm sóc', url: '/blog' },
];
---

<Layout
  title="Cẩm Nang Chăm Sóc Cha Mẹ Tại Nhà | Giúp Cha Mẹ"
  description="Kiến thức y khoa dễ hiểu từ BS. Tâm, bài toán tiền nong thực tế từ Ông Minh và những câu chuyện gia đình gần gũi giúp bạn chăm sóc cha mẹ già mà không kiệt sức."
  breadcrumbs={breadcrumbs}
>
  <!-- Blog Hub Hero & Breadcrumb -->
  <section class="blog-hub-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">
          <i class="bi bi-house-door" aria-hidden="true"></i> Trang chủ
        </a>
        <i class="bi bi-chevron-right breadcrumb__sep" aria-hidden="true"></i>
        <span class="breadcrumb__current">Cẩm nang Chăm sóc</span>
      </nav>

      <h1 class="blog-hub-hero__title">
        Cẩm Nang Thực Tế &amp; Kinh Nghiệm Chăm Sóc Cha Mẹ Già
      </h1>
      <p class="blog-hub-hero__subtitle">
        Kiến thức y khoa dễ hiểu từ TS. BS. Tâm, bài toán chi phí từ Ông Minh và những sẻ chia chân thành của người con giữa hai đầu gánh nặng.
      </p>

      <!-- Filter Bar: Umbrex Pills & Search Input -->
      <div class="blog-filter-bar">
        <div class="category-pills" aria-label="Lọc theo danh mục bài viết">
          <button type="button" class="category-pill active" data-filter="all">
            <i class="bi bi-grid-fill" aria-hidden="true"></i>
            <span>Tất cả ({sortedPosts.length})</span>
          </button>
          <button type="button" class="category-pill" data-filter="Educate">
            <i class="bi bi-journal-medical" aria-hidden="true"></i>
            <span>Hiểu Bệnh &amp; Chi Phí</span>
          </button>
          <button type="button" class="category-pill" data-filter="Inspire">
            <i class="bi bi-heart-fill" aria-hidden="true"></i>
            <span>Nỗi Lòng Người Con</span>
          </button>
          <button type="button" class="category-pill" data-filter="Entertain">
            <i class="bi bi-cup-hot-fill" aria-hidden="true"></i>
            <span>Chuyện Nhà &amp; Lối Sống</span>
          </button>
          <button type="button" class="category-pill" data-filter="Convince">
            <i class="bi bi-compass-fill" aria-hidden="true"></i>
            <span>Cách Chăm Sóc Tại Nhà</span>
          </button>
        </div>

        <div class="blog-search-box">
          <i class="bi bi-search blog-search-box__icon" aria-hidden="true"></i>
          <input
            type="search"
            id="blog-search-input"
            class="blog-search-box__input"
            placeholder="Tìm theo vấn đề (thuê người chăm, đãng trí, tiền nong, đối thoại...)"
            aria-label="Tìm kiếm bài viết"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Article Feed Grid -->
  <section class="container blog-feed-section">
    <div class="posts-grid" id="blog-posts-grid">
      {sortedPosts.map((post) => (
        <ArticleCard
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          pubDate={post.data.pubDate}
          quadrant={post.data.quadrant}
          tags={post.data.tags}
          thumbnailUrl={post.data.thumbnail || post.data.featurePhoto}
          readingTime={post.data.readingTime || 8}
        />
      ))}
    </div>

    <div id="blog-empty-result" class="empty-state" style="display: none;">
      <p>Không tìm thấy bài viết nào khớp với từ khóa tìm kiếm. Hãy thử từ khóa khác hoặc bấm Tất cả.</p>
    </div>
  </section>

  <!-- Full-width Micro-Care Banner (100% screen width bg, container inner) -->
  <section id="cam-nang-vi-mo" class="micro-care-banner">
    <div class="container micro-care-banner__inner">
      <div class="micro-care-banner__content">
        <span class="micro-care-banner__badge">
          <i class="bi bi-heart-pulse-fill" aria-hidden="true"></i> Điểm tựa từ Giúp Cha Mẹ
        </span>
        <h2 class="micro-care-banner__title">
          Chăm sóc cha mẹ già mà không làm khổ chính mình
        </h2>
        <p class="micro-care-banner__desc">
          Tải miễn phí <strong>"Bản hướng dẫn ngồi lại đối thoại cùng gia đình và thiết lập phương án có người phụ giúp tại nhà"</strong> do TS.BS Tâm &amp; Cố vấn tài chính Ông Minh biên soạn.
        </p>
        <div class="micro-care-banner__actions">
          <a href="/cam-nang-cham-soc" class="btn btn--accent">
            <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i>
            <span>Tải Cẩm Nang Chăm Sóc Cho Mẹ</span>
          </a>
        </div>
      </div>
      <div class="micro-care-banner__visual">
        <img
          src={MEDIA_ASSETS.microCareGraphic}
          alt="Cẩm nang chăm sóc vi mô Kinship AI"
          class="micro-care-banner__img"
          width="600"
          height="400"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const pills = document.querySelectorAll('.category-pill[data-filter]');
      const searchInput = document.getElementById('blog-search-input');
      const cards = document.querySelectorAll('#blog-posts-grid .article-card');
      const emptyState = document.getElementById('blog-empty-result');

      let activeQuadrant = 'all';
      let searchQuery = '';

      function filterArticles() {
        let visibleCount = 0;
        cards.forEach((card) => {
          const quad = card.getAttribute('data-quadrant') || '';
          const title = card.getAttribute('data-title') || '';
          const tags = card.getAttribute('data-tags') || '';
          const desc = card.textContent ? card.textContent.toLowerCase() : '';

          const matchesQuad = activeQuadrant === 'all' || quad === activeQuadrant;
          const matchesSearch =
            !searchQuery ||
            title.includes(searchQuery) ||
            tags.includes(searchQuery) ||
            desc.includes(searchQuery);

          const show = matchesQuad && matchesSearch;
          card.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      const params = new URLSearchParams(window.location.search);
      const urlQuad = params.get('quadrant');
      if (urlQuad) {
        activeQuadrant = urlQuad;
        pills.forEach((p) => {
          p.classList.toggle('active', p.getAttribute('data-filter') === activeQuadrant);
        });
        filterArticles();
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          activeQuadrant = pill.getAttribute('data-filter') || 'all';
          pills.forEach((p) => p.classList.toggle('active', p === pill));
          filterArticles();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = (e.target.value || '').trim().toLowerCase();
          filterArticles();
        });
      }
    });
  </script>
</Layout>
