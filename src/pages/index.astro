---
import Layout from '../layouts/Layout.astro';
import QuadrantBadge from '../components/QuadrantBadge.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { MEDIA_ASSETS, getArticleFeaturePhoto, getArticleThumbnail } from '../utils/media';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('vi-VN', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  }).format(new Date(date));
}

// Chuẩn bị 3 slides cho Hero Carousel (uslider)
const heroSlides = [
  {
    badgeIcon: 'bi bi-heart-pulse-fill',
    badgeText: 'Điểm tựa thực tế cho tuổi trung niên',
    titlePrefix: 'Cảnh làm con kẹt giữa ',
    titleHighlight: 'hai đầu gánh nặng:',
    titleSuffix: ' giữ sức khỏe cho mình & chăm cha mẹ già tại nhà',
    subtitle:
      'Nhìn thẳng vào áp lực tiền bạc, sự mệt mỏi thể xác và những va chạm thế hệ trong gia đình Việt. Không dạy đời, không phán xét đạo đức, không vẽ màu hồng.',
    primaryCtaText: 'Đọc Bài Viết Thực Tế',
    primaryCtaHref: '#bai-viet',
    secondaryCtaText: 'Người Đồng Hành Cùng Bạn',
    secondaryCtaHref: '#hoi-dong-chuyen-gia',
    image: MEDIA_ASSETS.heroSlides[0],
    floatingIcon: 'bi bi-heart-fill',
    floatingTitle: 'Đỡ đần từng việc nhỏ',
    floatingSub: 'Giữ trọn tình thân, không kiệt sức',
  },
  {
    badgeIcon: 'bi bi-heart-pulse-fill',
    badgeText: 'Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD)',
    titlePrefix: 'Thương cha mẹ ',
    titleHighlight: 'đúng cách',
    titleSuffix: ' mà không tự làm khổ bản thân',
    subtitle:
      'Giải thích cặn kẽ bệnh tuổi già và tâm lý tuổi trung niên bằng ngôn ngữ đời thường, giúp bạn hiểu rõ cơ thể mình và chăm sóc cha mẹ nhẹ lòng hơn.',
    primaryCtaText: 'Xem Lời Khuyên Của Henry Tâm',
    primaryCtaHref: '/blog?quadrant=Educate',
    secondaryCtaText: 'Gặp Gỡ Henry Tâm',
    secondaryCtaHref: '#hoi-dong-chuyen-gia',
    image: MEDIA_ASSETS.heroSlides[1],
    floatingIcon: 'bi bi-patch-check-fill',
    floatingTitle: 'Tâm lý & Y khoa dễ hiểu',
    floatingSub: 'Nói chuyện đời thường, không hù dọa',
  },
  {
    badgeIcon: 'bi bi-calculator',
    badgeText: 'Cố vấn Tài chính Gia đình',
    titlePrefix: 'Bài toán tiền nong: ',
    titleHighlight: 'Tính đúng chi phí',
    titleSuffix: ' để không sụp đổ kinh tế',
    subtitle:
      'Cùng Ông Minh cầm bút tính toán: thuê người phụ chăm sóc hết bao nhiêu, chuẩn bị quỹ dự phòng thế nào khi cha mẹ ốm đau dài ngày.',
    primaryCtaText: 'Tính Chi Phí Chăm Sóc Tại Nhà',
    primaryCtaHref: '/blog?quadrant=Convince',
    secondaryCtaText: 'Tải Hướng Dẫn Chi Phí',
    secondaryCtaHref: '#cam-nang-vi-mo',
    image: MEDIA_ASSETS.heroSlides[2],
    floatingIcon: 'bi bi-shield-check',
    floatingTitle: 'Minh bạch & Thực tế',
    floatingSub: 'Bảo vệ kinh tế cho cả hai thế hệ',
  },
];

// Chuẩn bị Top 4 Featured Posts (1 bài chính bên trái + 3 bài nhỏ bên phải)
interface FeaturedItem {
  title: string;
  description: string;
  url: string;
  pubDate: Date;
  quadrant: string;
  tags: string[];
  readingTime: number;
  image: string;
}

const realFeaturedItems: FeaturedItem[] = sortedPosts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  url: `/blog/${p.slug}`,
  pubDate: p.data.pubDate,
  quadrant: p.data.quadrant || 'Educate',
  tags: (p.data.tags || [])
    .map((t) => t.replace(/^kinship\//, ''))
    .filter((t) => t !== 'content' && t !== 'UmbrexMatrix'),
  readingTime: p.data.readingTime || 8,
  image: getArticleFeaturePhoto(p.data.featurePhoto, p.slug, p.data.quadrant),
}));

const fallbackFeaturedItems: FeaturedItem[] = [
  {
    title: 'Thuê Người Phụ Chăm Sóc Tại Nhà: Bài Toán Chi Phí & Cách Chọn Người Phù Hợp',
    description:
      'Cùng Ông Minh tính toán chi tiết ngân sách thuê người phụ chăm sóc theo giờ và bán trú, giúp con cái giảm tải việc nhà mà cha mẹ vẫn được ở quen thuộc trong mái ấm.',
    url: realFeaturedItems[0]?.url || '/blog',
    pubDate: new Date('2026-11-03'),
    quadrant: 'Convince',
    tags: ['ChiPhiGiaDinh', 'ChamSocTaiNha', 'NguoiPhuGiup'],
    readingTime: 7,
    image: getArticleThumbnail(undefined, 'Convince'),
  },
  {
    title: 'Nói Chuyện Với Cha Mẹ Về Tuổi Già: Cách Mở Lời Khi Cha Mẹ Còn Khỏe',
    description:
      'Gợi ý từ Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD) giúp anh chị em trong nhà cùng ngồi lại trò chuyện thẳng thắn về kế hoạch dưỡng già, lắng nghe tâm tư đấng sinh thành mà không tạo cảm giác đùn đẩy trách nhiệm.',
    url: realFeaturedItems[1]?.url || '/blog',
    pubDate: new Date('2026-11-02'),
    quadrant: 'Inspire',
    tags: ['DoiThoaiGiaDinh', 'TamLyTuoiGia', 'HieuChaMe'],
    readingTime: 6,
    image: getArticleThumbnail(undefined, 'Inspire'),
  },
];

const topFourPosts: FeaturedItem[] = [...realFeaturedItems, ...fallbackFeaturedItems].slice(0, 4);
const mainFeaturedPost = topFourPosts[0];
const sideFeaturedPosts = topFourPosts.slice(1, 4);
---

<Layout
  title="Giúp Cha Mẹ | Chăm sóc cha mẹ già & Điểm tựa sức khỏe tuổi trung niên"
  description="Kiến thức tâm lý & y khoa dễ hiểu từ Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD), bài toán tài chính chăm sóc tại nhà từ Ông Minh và công cụ đồng hành giúp bạn chăm sóc cha mẹ mà không kiệt sức."
>
  <!-- 1. HERO SECTION — USLIDER 3-SLIDE CAROUSEL WITH SOFT ANIMATION -->
  <section class="hero-section" aria-label="Tiêu điểm Kinship AI">
    <div class="container">
      <div class="uslider" id="hero-uslider">
        <div class="uslider__track">
          {heroSlides.map((slide, idx) => (
            <div
              class={idx === 0 ? 'uslider__slide is-active' : 'uslider__slide'}
              data-slide-index={idx}
              aria-hidden={idx === 0 ? 'false' : 'true'}
            >
              <div class="hero-grid">
                <!-- Cột Trái (50% Text & Actions) -->
                <div class="hero-content">
                  <h1 class="hero-title">
                    {slide.titlePrefix}
                    <span>{slide.titleHighlight}</span>
                    {slide.titleSuffix}
                  </h1>

                  <p class="hero-subtitle">{slide.subtitle}</p>

                  <div class="hero-trust-proof">
                    <span class="trust-proof-item">
                      <i class="bi bi-check-circle-fill trust-check" aria-hidden="true"></i>
                      <span>Nhìn thẳng áp lực thực tế</span>
                    </span>
                    <span class="trust-proof-item">
                      <i class="bi bi-check-circle-fill trust-check" aria-hidden="true"></i>
                      <span>Căn cứ &amp; số liệu rõ ràng</span>
                    </span>
                  </div>

                  <div class="hero-actions">
                    <a href={slide.primaryCtaHref} class="btn btn--primary">
                      <span>{slide.primaryCtaText}</span>
                      <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>
                    </a>
                    <a href={slide.secondaryCtaHref} class="btn btn--outline">
                      <span>{slide.secondaryCtaText}</span>
                    </a>
                  </div>
                </div>

                <!-- Cột Phải (50% Feature Hero Image) -->
                <div class="hero-visual">
                  <div class="hero-image-wrapper">
                    <img
                      src={slide.image}
                      alt={slide.titleHighlight}
                      class="hero-image"
                      width="800"
                      height="600"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      fetchpriority={idx === 0 ? 'high' : 'auto'}
                    />
                    <div class="hero-floating-badge">
                      <i class={`${slide.floatingIcon} hero-floating-badge__icon`} aria-hidden="true"></i>
                      <div>
                        <strong>{slide.floatingTitle}</strong>
                        <span>{slide.floatingSub}</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Điều hướng Slider (Prev / Dots / Next) -->
        <div class="uslider__controls" aria-label="Điều khiển trình chiếu Hero">
          <button
            type="button"
            class="uslider__arrow uslider__arrow--prev"
            id="uslider-prev"
            aria-label="Slide trước"
          >
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
          </button>

          <div class="uslider__dots" aria-label="Điều hướng slide">
            {heroSlides.map((_, idx) => (
              <button
                type="button"
                class={idx === 0 ? 'uslider__dot is-active' : 'uslider__dot'}
                data-goto-slide={idx}
                aria-label={`Chuyển tới slide ${idx + 1}`}
              />
            ))}
          </div>

          <button
            type="button"
            class="uslider__arrow uslider__arrow--next"
            id="uslider-next"
            aria-label="Slide tiếp theo"
          >
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. HỘI ĐỒNG CỐ VẤN CHUYÊN MÔN (NGƯỜI ĐỒNG HÀNH CÙNG BẠN) -->
  <section id="hoi-dong-chuyen-gia" class="trust-bar-section container">
    <div class="trust-bar-header">
      <span class="section-eyebrow">
        <i class="bi bi-people-fill" aria-hidden="true"></i> Người Đồng Hành Cùng Bạn
      </span>
      <h2 class="trust-bar-title">
        Góc nhìn đa chiều, nói thật và có trách nhiệm từ Giúp Cha Mẹ
      </h2>
    </div>

    <div class="trust-experts-grid">
      <div class="expert-card">
        <img
          src={MEDIA_ASSETS.avatars.drTam}
          alt="Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD)"
          class="expert-card__avatar"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="expert-card__info">
          <div class="expert-card__role-tag">
            <i class="bi bi-heart-pulse-fill" aria-hidden="true"></i> Tâm lý trị liệu &amp; Sức khỏe Lão khoa
          </div>
          <h3 class="expert-card__name">Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD)</h3>
          <p class="expert-card__desc">
            "Là một nhà tâm lý trị liệu, nhưng tôi cũng là một người đàn ông trung niên từng trải qua cảm giác bất lực khi cha mẹ già yếu đi mỗi ngày. Y học và tâm lý không phải để đao to búa lớn hay dọa nạt. Tôi ở đây để cùng bạn thương cha mẹ đúng cách, khoa học và không để bản thân kiệt sức."
          </p>
        </div>
      </div>

      <div class="expert-card">
        <img
          src={MEDIA_ASSETS.avatars.mrMinh}
          alt="Ông Minh — Cố vấn Tài chính Gia đình"
          class="expert-card__avatar"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="expert-card__info">
          <div class="expert-card__role-tag">
            <i class="bi bi-calculator" aria-hidden="true"></i> Cố vấn Tài chính Gia đình
          </div>
          <h3 class="expert-card__name">Ông Minh</h3>
          <p class="expert-card__desc">
            "Tình thương sâu nặng đến đâu thì cuối tháng hóa đơn thuốc men và chi phí người chăm sóc vẫn gõ cửa. Đừng để áp lực kinh tế bào mòn tình cảm gia đình. Hãy cùng tôi ngồi lại cầm bút tính đúng chi phí thực tế, lập quỹ dự phòng và bảo vệ an toàn tài chính cho cả hai thế hệ."
          </p>
        </div>
      </div>

      <div class="expert-card">
        <img
          src={MEDIA_ASSETS.avatars.nhungPham}
          alt="Nhung Phạm — Đồng sáng lập Giúp Cha Mẹ"
          class="expert-card__avatar"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="expert-card__info">
          <div class="expert-card__role-tag">
            <i class="bi bi-heart-fill" aria-hidden="true"></i> Tiếng nói người con GenY
          </div>
          <h3 class="expert-card__name">Nhung Phạm</h3>
          <p class="expert-card__desc">
            "Tôi thấu hiểu cảm giác vừa loay hoay trong công việc, vừa thắt lòng vì những cuộc điện thoại của cha mẹ ốm đau ở quê. Giúp Cha Mẹ ra đời từ chính những trăn trở thật ấy — để bạn luôn có một điểm tựa thiết thực, đỡ đần từng việc nhỏ và không bao giờ phải cô độc trên hành trình báo hiếu."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2.5. SECTION VỀ CHÚNG TÔI (ABOUT US - FULL WIDTH BACKGROUND) -->
  <section id="ve-chung-toi" class="about-section">
    <div class="container about-section__inner">
      <div class="about-card">
      <div class="about-card__header">
        <span class="section-eyebrow">
          <i class="bi bi-compass-fill" aria-hidden="true"></i> Về Giúp Cha Mẹ
        </span>
        <h2 class="section-title">Điểm tựa tinh thần cho GenY giữa hai giữa hai thế hệ cần chăm sóc</h2>
      </div>
      <p class="about-lead">
        Chúng tôi hiểu cảm giác vừa bước qua tuổi 40: cơ thể bắt đầu báo hiệu mệt mỏi, nhưng trên vai là cha mẹ già ngày một yếu đi và con cái đang tuổi lớn.
      </p>
      <p class="about-sublead">
        <strong>Giúp Cha Mẹ</strong> ra đời từ thực tế đó, dựa trên 3 nguyên tắc không thỏa hiệp:
      </p>
      <div class="about-principles-grid">
        <div class="principle-item">
          <div class="principle-icon">
            <i class="bi bi-eye-fill" aria-hidden="true"></i>
          </div>
          <div class="principle-body">
            <h3 class="principle-title">Thấu hiểu thực tế</h3>
            <p class="principle-desc">
              Nhìn thẳng vào áp lực tiền bạc, sự mệt mỏi kép và những va chạm thế hệ trong gia đình Việt mà không phán xét đạo đức.
            </p>
          </div>
        </div>
        <div class="principle-item">
          <div class="principle-icon">
            <i class="bi bi-shield-check" aria-hidden="true"></i>
          </div>
          <div class="principle-body">
            <h3 class="principle-title">Thông tin chuẩn xác</h3>
            <p class="principle-desc">
              Mọi kiến thức tâm lý lão khoa và bài toán chi phí đều có nguồn gốc rõ ràng, được kiểm chứng bởi Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD) và Cố vấn tài chính Ông Minh.
            </p>
          </div>
        </div>
        <div class="principle-item">
          <div class="principle-icon">
            <i class="bi bi-heart-fill" aria-hidden="true"></i>
          </div>
          <div class="principle-body">
            <h3 class="principle-title">Giữ trọn tình người</h3>
            <p class="principle-desc">
              Công nghệ và dịch vụ chăm sóc tại nhà chỉ đóng vai trò đỡ đần việc vặt, nhắc lịch uống thuốc và lưu giữ ký ức gia đình — tuyệt đối không thay thế tình cảm thật của con cái.
            </p>
          </div>
        </div>
      </div>
      <div class="about-signature">
        <p>— <strong>Nhung Phạm</strong> (Đồng sáng lập) cùng đội ngũ Giúp Cha Mẹ.</p>
      </div>
    </div>
  </div>
</section>

  <!-- 3. SECTION BAI-VIET: TOP 4 FEATURED POSTS (1 MAIN LEFT + 3 SMALL RIGHT) & UMBREX GRID -->
  <section id="bai-viet" class="posts-section container">
    <div class="section-header-row">
      <div>
        <span class="section-eyebrow">
          <i class="bi bi-journal-text" aria-hidden="true"></i> Cẩm nang thực tế
        </span>
        <h2 class="section-title">Chuyện chăm sóc cha mẹ già: Nói thật, tính thật</h2>
        <p class="section-subtitle">
          Kiến thức tâm lý &amp; sức khỏe dễ hiểu từ Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD), bài toán chi phí từ Ông Phạm Minh và kinh nghiệm chăm sóc cha mẹ tại nhà.
        </p>
      </div>
      <a href="/blog" class="btn btn--outline btn--sm">
        <span>Xem tất cả bài viết cẩm nang</span>
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <!-- Top 4 Feature Post Block: 1 Main Article on Left + 3 Small Articles on Right -->
    {mainFeaturedPost && (
      <div class="top4-feature-grid">
        <!-- Cột Trái: 1 Bài Viết Chính (Main Featured Article) -->
        <article class="top4-main-card">
          <a href={mainFeaturedPost.url} class="top4-main-card__media">
            <img
              src={mainFeaturedPost.image}
              alt={mainFeaturedPost.title}
              class="top4-main-card__img"
              width="1200"
              height="630"
              loading="eager"
            />
          </a>

          <div class="top4-main-card__body">
            <div class="article-card__meta">
              <QuadrantBadge quadrant={mainFeaturedPost.quadrant} />
              <span class="article-card__meta-sep">•</span>
              <time datetime={new Date(mainFeaturedPost.pubDate).toISOString()}>
                <i class="bi bi-calendar3" aria-hidden="true"></i> {formatDate(mainFeaturedPost.pubDate)}
              </time>
              <span class="article-card__meta-sep">•</span>
              <span>
                <i class="bi bi-clock" aria-hidden="true"></i> {mainFeaturedPost.readingTime} phút đọc
              </span>
            </div>

            <h3 class="top4-main-card__title">
              <a href={mainFeaturedPost.url}>{mainFeaturedPost.title}</a>
            </h3>

            <p class="top4-main-card__desc">{mainFeaturedPost.description}</p>

            {mainFeaturedPost.tags.length > 0 && (
              <div class="article-card__tags">
                {mainFeaturedPost.tags.slice(0, 4).map((tag) => (
                  <span class="tag-pill">#{tag}</span>
                ))}
              </div>
            )}

            <div class="top4-main-card__footer">
              <a href={mainFeaturedPost.url} class="btn btn--primary btn--sm">
                <span>Đọc bài phân tích đầy đủ</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </article>

        <!-- Cột Phải: 3 Bài Viết Nhỏ (3 Small Articles Stacked) -->
        <div class="top4-side-list">
          {sideFeaturedPosts.map((item) => (
            <article class="top4-side-card">
              <a href={item.url} class="top4-side-card__thumb-wrap" tabindex="-1" aria-hidden="true">
                <img
                  src={item.image}
                  alt={item.title}
                  class="top4-side-card__thumb"
                  width="320"
                  height="180"
                  loading="lazy"
                />
              </a>
              <div class="top4-side-card__content">
                <div class="top4-side-card__meta">
                  <QuadrantBadge quadrant={item.quadrant} />
                  <span>
                    <i class="bi bi-calendar3" aria-hidden="true"></i> {formatDate(item.pubDate)}
                  </span>
                </div>
                <h4 class="top4-side-card__title">
                  <a href={item.url}>{item.title}</a>
                </h4>
                <p class="top4-side-card__desc">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}

    <!-- Taxonomy Filter Pills -->
    <div class="category-pills" role="tablist" aria-label="Lọc bài viết theo danh mục">
      <button type="button" class="category-pill active" data-filter="all">
        <i class="bi bi-grid-fill" aria-hidden="true"></i>
        <span>Tất cả ({sortedPosts.length})</span>
      </button>
      <button type="button" class="category-pill" data-filter="Educate">
        <i class="bi bi-journal-medical" aria-hidden="true"></i>
        <span>Hiểu Bệnh &amp; Chi Phí</span>
      </button>
      <button type="button" class="category-pill" data-filter="Inspire">
        <i class="bi bi-heart-fill" aria-hidden="true"></i>
        <span>Nỗi Lòng Người Con</span>
      </button>
      <button type="button" class="category-pill" data-filter="Entertain">
        <i class="bi bi-cup-hot-fill" aria-hidden="true"></i>
        <span>Chuyện Nhà &amp; Lối Sống</span>
      </button>
      <button type="button" class="category-pill" data-filter="Convince">
        <i class="bi bi-compass-fill" aria-hidden="true"></i>
        <span>Cách Chăm Sóc Tại Nhà</span>
      </button>
    </div>

    {sortedPosts.length === 0 ? (
      <div class="empty-state">
        <p>Chưa có bài viết nào được xuất bản.</p>
      </div>
    ) : (
      <div class="posts-grid" id="home-posts-grid">
        {sortedPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            pubDate={post.data.pubDate}
            quadrant={post.data.quadrant}
            tags={post.data.tags}
            thumbnailUrl={post.data.thumbnail || post.data.featurePhoto}
            readingTime={post.data.readingTime || 8}
          />
        ))}
      </div>
    )}
  </section>

  <!-- 4. GIẢI PHÁP ĐỒNG HÀNH VI MÔ (MICRO-CARE BANNER: 100% WIDTH BG, CONTAINER INNER) -->
  <section id="cam-nang-vi-mo" class="micro-care-banner">
    <div class="container micro-care-banner__inner">
      <div class="micro-care-banner__content">
        <span class="micro-care-banner__badge">
          <i class="bi bi-heart-pulse-fill" aria-hidden="true"></i> Điểm tựa từ Giúp Cha Mẹ
        </span>
        <h2 class="micro-care-banner__title">
          Bạn không phải một mình gồng gánh tất cả.
        </h2>
        <p class="micro-care-banner__desc">
          Tải ngay <strong>"Bản hướng dẫn ngồi lại đối thoại gia đình &amp; tính toán chi phí chăm sóc tại nhà"</strong> — bộ tài liệu thực hành do Nhà tâm lý trị liệu Henry Tâm (ông chú ADHD) và Cố vấn tài chính Ông Minh biên soạn, giúp bạn chủ động chuẩn bị kinh tế và thiết lập phương án chăm sóc người thân mà không kiệt sức.
        </p>
        <div class="micro-care-banner__actions">
          <a href="/cam-nang-cham-soc" class="btn btn--accent">
            <i class="bi bi-download" aria-hidden="true"></i>
            <span>Tải Bản Hướng Dẫn Thực Tế</span>
          </a>
        </div>
      </div>

      <div class="micro-care-banner__visual">
        <img
          src={MEDIA_ASSETS.microCareGraphic}
          alt="Cẩm nang chăm sóc vi mô Kinship AI"
          class="micro-care-banner__img"
          width="600"
          height="400"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Khởi tạo Hero Carousel (uslider 3 slides + soft animation)
      const slider = document.getElementById('hero-uslider');
      if (slider) {
        const slides = slider.querySelectorAll('.uslider__slide');
        const dots = slider.querySelectorAll('.uslider__dot');
        const prevBtn = document.getElementById('uslider-prev');
        const nextBtn = document.getElementById('uslider-next');
        let currentSlide = 0;
        let autoTimer = null;

        function goToSlide(index) {
          const total = slides.length;
          currentSlide = (index + total) % total;
          slides.forEach((s, i) => {
            const active = i === currentSlide;
            s.classList.toggle('is-active', active);
            s.setAttribute('aria-hidden', active ? 'false' : 'true');
          });
          dots.forEach((d, i) => {
            d.classList.toggle('is-active', i === currentSlide);
          });
        }

        function startAutoPlay() {
          stopAutoPlay();
          autoTimer = setInterval(() => {
            goToSlide(currentSlide + 1);
          }, 6000);
        }

        function stopAutoPlay() {
          if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
          }
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            goToSlide(currentSlide - 1);
            startAutoPlay();
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            goToSlide(currentSlide + 1);
            startAutoPlay();
          });
        }

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const target = parseInt(dot.getAttribute('data-goto-slide') || '0', 10);
            goToSlide(target);
            startAutoPlay();
          });
        });

        slider.addEventListener('mouseenter', stopAutoPlay);
        slider.addEventListener('mouseleave', startAutoPlay);
        startAutoPlay();
      }

      // 2. Bộ lọc Ma trận Umbrex
      const pills = document.querySelectorAll('.category-pill[data-filter]');
      const cards = document.querySelectorAll('#home-posts-grid .article-card');

      function applyFilter(quadrant) {
        pills.forEach((p) => {
          p.classList.toggle('active', p.getAttribute('data-filter') === quadrant);
        });
        cards.forEach((card) => {
          const cardQuad = card.getAttribute('data-quadrant');
          const match = quadrant === 'all' || cardQuad === quadrant;
          card.style.display = match ? '' : 'none';
        });
      }

      const params = new URLSearchParams(window.location.search);
      const initialQuad = params.get('quadrant');
      if (initialQuad) {
        applyFilter(initialQuad);
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const filter = pill.getAttribute('data-filter') || 'all';
          applyFilter(filter);
        });
      });
    });
  </script>
</Layout>
