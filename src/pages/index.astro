---
import Layout from '../layouts/Layout.astro';
import QuadrantBadge from '../components/QuadrantBadge.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { MEDIA_ASSETS, getArticleFeaturePhoto } from '../utils/media';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const featuredPost = sortedPosts[0] || null;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('vi-VN', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  }).format(new Date(date));
}
---

<Layout
  title="Trang chủ — Đồng hành cùng thế hệ Bánh Mì Kẹp chăm sóc cha mẹ già"
  description="Thấu hiểu tâm lý lão khoa, hóa giải dằn vặt chữ Hiếu và thiết kế hệ thống chăm sóc bền vững cho gia đình Việt Nam hiện đại."
>
  <!-- 1. HERO SECTION (50% Left Text & Actions / 50% Right Feature Hero Image) -->
  <section class="hero-section">
    <div class="container hero-grid">
      <!-- Cột Trái (50% Text & Actions) -->
      <div class="hero-content">
        <div class="hero-badge">
          <span aria-hidden="true">🌱</span>
          <span>Cầu nối gia đình &amp; Đồng hành vi mô</span>
        </div>

        <h1 class="hero-title">
          Đồng hành cùng thế hệ <span>Bánh Mì Kẹp</span> chăm sóc cha mẹ già tại gia
        </h1>

        <p class="hero-subtitle">
          Thấu hiểu tâm lý lão khoa, hóa giải dằn vặt chữ Hiếu và thiết kế hệ thống chăm sóc bền vững cho gia đình Việt Nam hiện đại.
        </p>

        <div class="hero-actions">
          <a href="/blog" class="btn btn--primary">
            <span>Khám phá Bài viết Chuyên sâu</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#hoi-dong-chuyen-gia" class="btn btn--outline">
            Về Hội đồng Chuyên gia
          </a>
        </div>

        <div class="hero-trust-proof">
          <span class="trust-proof-item">
            <strong class="trust-check">✓</strong> 72% người trẻ sẵn sàng chăm sóc
          </span>
          <span class="trust-proof-item">
            <strong class="trust-check">✓</strong> 100% dữ liệu thực chứng E-E-A-T
          </span>
        </div>
      </div>

      <!-- Cột Phải (50% Feature Hero Image) -->
      <div class="hero-visual">
        <div class="hero-image-wrapper">
          <img
            src={MEDIA_ASSETS.heroFamilyImage}
            alt="Kinship AI — Đồng hành cùng gia đình chăm sóc cha mẹ già tại gia"
            class="hero-image"
            width="800"
            height="600"
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero-floating-badge">
            <span class="hero-floating-badge__icon" aria-hidden="true">💡</span>
            <div>
              <strong>Micro-Care 24/7</strong>
              <span>Giải pháp bán trú &amp; chăm sóc tại gia</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. HỘI ĐỒNG CỐ VẤN CHUYÊN MÔN (E-E-A-T TRUST BAR) -->
  <section id="hoi-dong-chuyen-gia" class="trust-bar-section container">
    <div class="trust-bar-header">
      <span class="section-eyebrow">Bảo chứng Chuyên môn (E-E-A-T)</span>
      <h2 class="trust-bar-title">
        Góc nhìn đa chiều bảo chứng chất lượng bởi Hội đồng chuyên gia Kinship AI
      </h2>
    </div>

    <div class="trust-experts-grid">
      <div class="expert-card">
        <img
          src={MEDIA_ASSETS.avatars.drTam}
          alt="TS. BS. Tâm — Chuyên gia Tâm lý Lão khoa"
          class="expert-card__avatar"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="expert-card__info">
          <div class="expert-card__role-tag">👨‍⚕️ Cố vấn Tâm lý Lão khoa</div>
          <h3 class="expert-card__name">TS. BS. Tâm</h3>
          <p class="expert-card__desc">
            Chuyên gia Lão học &amp; Tâm lý gia đình. Thẩm định các giải pháp hóa giải mặc cảm tội lỗi (Caregiver Guilt) và Hội chứng Tê liệt Đạo hiếu.
          </p>
        </div>
      </div>

      <div class="expert-card">
        <img
          src={MEDIA_ASSETS.avatars.mrMinh}
          alt="Chuyên gia Tài chính Minh — Hoạch định dòng tiền dưỡng lão"
          class="expert-card__avatar"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="expert-card__info">
          <div class="expert-card__role-tag">💼 Cố vấn Quản trị Tài chính</div>
          <h3 class="expert-card__name">Ông Minh</h3>
          <p class="expert-card__desc">
            Chuyên gia Hoạch định Dòng tiền Dưỡng lão. Phân tích bài toán viện dưỡng lão, quỹ dự phòng rủi ro y tế dài hạn và giải pháp micro-care vừa túi tiền.
          </p>
        </div>
      </div>

      <div class="expert-card">
        <img
          src={MEDIA_ASSETS.avatars.nhungPham}
          alt="Nhung Pham — Founder & Caregiver Advocate"
          class="expert-card__avatar"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="expert-card__info">
          <div class="expert-card__role-tag">✍️ Góc nhìn Thực tiễn (Founder POV)</div>
          <h3 class="expert-card__name">Nhung Pham</h3>
          <p class="expert-card__desc">
            Founder &amp; Caregiver Advocate. Đồng hành thực tế cùng cha mẹ già tuổi 70+, kết nối khoa học lão khoa với hơi ấm văn hóa gia đình Việt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. FEATURED POST HERO CARD (BÀI VIẾT TÂM ĐIỂM MỚI NHẤT) -->
  {featuredPost && (
    <section class="featured-section container">
      <div class="section-header-row">
        <div>
          <span class="section-eyebrow">🔥 Tiêu điểm Nghiên cứu</span>
          <h2 class="section-title">Bài viết tâm điểm mới nhất</h2>
        </div>
      </div>

      <article class="featured-hero-card">
        <a href={`/blog/${featuredPost.slug}`} class="featured-hero-card__media">
          <img
            src={getArticleFeaturePhoto(
              featuredPost.data.featurePhoto,
              featuredPost.slug,
              featuredPost.data.quadrant
            )}
            alt={featuredPost.data.title}
            class="featured-hero-card__img"
            width="1200"
            height="630"
            loading="eager"
          />
        </a>

        <div class="featured-hero-card__content">
          <div class="featured-hero-card__meta">
            <QuadrantBadge quadrant={featuredPost.data.quadrant} />
            <span class="article-card__meta-sep">•</span>
            <time datetime={new Date(featuredPost.data.pubDate).toISOString()}>
              Ngày {formatDate(featuredPost.data.pubDate)}
            </time>
            <span class="article-card__meta-sep">•</span>
            <span>⏱️ {featuredPost.data.readingTime || 8} phút đọc</span>
          </div>

          <h2 class="featured-hero-card__title">
            <a href={`/blog/${featuredPost.slug}`}>{featuredPost.data.title}</a>
          </h2>

          <p class="featured-hero-card__lead">{featuredPost.data.description}</p>

          {featuredPost.data.tags && featuredPost.data.tags.length > 0 && (
            <div class="article-card__tags">
              {featuredPost.data.tags
                .map((t) => t.replace(/^kinship\//, ''))
                .filter((t) => t !== 'content' && t !== 'UmbrexMatrix')
                .slice(0, 4)
                .map((tag) => (
                  <span class="tag-pill">#{tag}</span>
                ))}
            </div>
          )}

          <div class="featured-hero-card__action">
            <a href={`/blog/${featuredPost.slug}`} class="btn btn--primary">
              <span>Đọc bài phân tích đầy đủ</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </section>
  )}

  <!-- 4. LƯỚI BÀI VIẾT THEO MA TRẬN UMBREX (3 CỘT RESPONSIVE GRID) -->
  <section id="bai-viet" class="posts-section container">
    <div class="section-header-row">
      <div>
        <span class="section-eyebrow">Trung tâm Tri thức Caregiver</span>
        <h2 class="section-title">Bài viết chuyên sâu theo Ma trận Umbrex</h2>
        <p class="section-subtitle">
          Lọc nội dung theo 4 góc phần tư tâm lý &amp; hành động dành riêng cho người chăm sóc.
        </p>
      </div>
      <a href="/blog" class="btn btn--outline btn--sm">
        Xem tất cả trên Caregiver Blog →
      </a>
    </div>

    <!-- Taxonomy Filter Pills -->
    <div class="category-pills" role="tablist" aria-label="Lọc bài viết theo góc phần tư Umbrex">
      <button type="button" class="category-pill active" data-filter="all">
        Tất cả ({sortedPosts.length})
      </button>
      <button type="button" class="category-pill" data-filter="Educate">
        📚 Educate (Kiến thức &amp; Tài chính)
      </button>
      <button type="button" class="category-pill" data-filter="Inspire">
        ❤️ Inspire (Tình cảm Gia đình)
      </button>
      <button type="button" class="category-pill" data-filter="Entertain">
        ☕ Entertain (Khoảng cách Thế hệ)
      </button>
      <button type="button" class="category-pill" data-filter="Convince">
        🎯 Convince (Giải pháp Vi mô)
      </button>
    </div>

    {sortedPosts.length === 0 ? (
      <div class="empty-state">
        <p>Chưa có bài viết nào được xuất bản.</p>
      </div>
    ) : (
      <div class="posts-grid" id="home-posts-grid">
        {sortedPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            pubDate={post.data.pubDate}
            quadrant={post.data.quadrant}
            tags={post.data.tags}
            thumbnailUrl={post.data.thumbnail}
            readingTime={post.data.readingTime || 8}
          />
        ))}
      </div>
    )}
  </section>

  <!-- 5. GIẢI PHÁP ĐỒNG HÀNH VI MÔ (MICRO-CARE INITIATIVE BANNER) -->
  <section id="cam-nang-vi-mo" class="container">
    <div class="micro-care-banner">
      <div class="micro-care-banner__content">
        <span class="micro-care-banner__badge">🌱 Sáng kiến Đồng hành Vi mô</span>
        <h2 class="micro-care-banner__title">
          Bạn không đơn độc trên hành trình phụng dưỡng cha mẹ.
        </h2>
        <p class="micro-care-banner__desc">
          Tải ngay <strong>"Cẩm nang Đối thoại Gia đình &amp; Lập ngân sách Chăm sóc Tuổi già"</strong> — bộ công cụ thực hành giúp hóa giải xung đột thế hệ và thiết lập mạng lưới chăm sóc bán trú vừa vặn dòng tiền.
        </p>
        <div class="micro-care-banner__actions">
          <a href="/blog" class="btn btn--accent">
            Tải Cẩm Nang Miễn Phí
          </a>
        </div>
      </div>

      <div class="micro-care-banner__visual">
        <img
          src={MEDIA_ASSETS.microCareGraphic}
          alt="Cẩm nang chăm sóc vi mô Kinship AI"
          class="micro-care-banner__img"
          width="600"
          height="400"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const pills = document.querySelectorAll('.category-pill[data-filter]');
      const cards = document.querySelectorAll('#home-posts-grid .article-card');

      function applyFilter(quadrant) {
        pills.forEach((p) => {
          p.classList.toggle('active', p.getAttribute('data-filter') === quadrant);
        });
        cards.forEach((card) => {
          const cardQuad = card.getAttribute('data-quadrant');
          const match = quadrant === 'all' || cardQuad === quadrant;
          card.style.display = match ? '' : 'none';
        });
      }

      const params = new URLSearchParams(window.location.search);
      const initialQuad = params.get('quadrant');
      if (initialQuad) {
        applyFilter(initialQuad);
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const filter = pill.getAttribute('data-filter') || 'all';
          applyFilter(filter);
        });
      });
    });
  </script>
</Layout>
